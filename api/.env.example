# 不設定就用記憶體儲存 + 本機假 embedder，可直接 go run 起來試流程
# Supabase → Project Settings → Database → Connection string（記得加 ?sslmode=require）
DATABASE_URL=postgres://postgres:password@db.xxxx.supabase.co:5432/postgres?sslmode=require

# https://dashboard.voyageai.com/ 申請
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite
EMBEDDING_DIMENSIONS=512

# 搜尋結果的相似度下限（0–1），0＝全部回傳。
# 用真實 Voyage 向量時建議從 0.5 起跳，避免不相關的筆記湊數。
SEARCH_MIN_SIMILARITY=0

PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 只有跑 pgvector 整合測試時需要（go test ./internal/store/）
# TEST_DATABASE_URL=postgres://notekeel:notekeel@127.0.0.1:5432/notekeel_test
