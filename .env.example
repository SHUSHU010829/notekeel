# ============================================================
# notekeel — 環境變數（複製成 .env.local）
# 全部跑在 Vercel 上，不需要另外的後端服務。
# ============================================================

# --- 與 taskeel 共用帳號與資料庫：填一模一樣的兩個值 ---
# 沒填的話不需要登入，筆記存在伺服器記憶體裡（重啟就消失），僅供本機試玩。
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# --- 伺服器端專用，千萬不要加 NEXT_PUBLIC_ 前綴 ---
# https://dashboard.voyageai.com/ 申請；沒設定就用本機假 embedder（只比對字面）
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite
EMBEDDING_DIMENSIONS=512

# 搜尋結果的相似度下限（0–1），0＝全部回傳。
# 用真實 Voyage 向量時建議 0.4–0.6，避免不相關的筆記湊數。
SEARCH_MIN_SIMILARITY=0
