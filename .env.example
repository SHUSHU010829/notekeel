# ============================================================
# notekeel — 環境變數（複製成 .env.local）
# 全部跑在 Vercel 上，不需要另外的後端服務。
# ============================================================

# --- 與 taskeel 共用帳號與資料庫：填一模一樣的兩個值 ---
# 沒填的話不需要登入，筆記存在伺服器記憶體裡（重啟就消失），僅供本機試玩。
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# --- 伺服器端專用，千萬不要加 NEXT_PUBLIC_ 前綴 ---
# https://dashboard.voyageai.com/ 申請；沒設定就用本機假 embedder（只比對字面）
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite
EMBEDDING_DIMENSIONS=512

# --- Rerank（強烈建議開著）---
# 向量搜尋負責「從全部筆記快速撈出候選」，rerank 負責「這些之中誰真的相關」。
# 有 VOYAGE_API_KEY 就自動啟用；要關掉設 SEARCH_RERANK=false。
# 代價：每次搜尋多一次 Voyage 請求（免費方案未綁付款方式只有 3 RPM）。
VOYAGE_RERANK_MODEL=rerank-2.5-lite
SEARCH_CANDIDATES=30
# rerank 分數的下限（0–1）。這個分數有校準過，比 SEARCH_MIN_SIMILARITY 適合設門檻，
# 但仍請先用 scripts/calibrate-browser.js 量過再設。
RERANK_MIN_SCORE=0

# 向量搜尋的相似度下限（0–1），0＝全部回傳（建議維持 0）。
# 實測正確命中可能只有 0.18–0.60，設高會把對的答案砍掉；
# 要過濾請優先用上面的 RERANK_MIN_SCORE。
SEARCH_MIN_SIMILARITY=0
